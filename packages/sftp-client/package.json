{
    "name": "@dockline/sftp-client",
    "version": "1.0.0",
    "description": "SFTP transfer client and host trust utilities for Dockline",
    "type": "module",
    "license": "MIT",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
        "npm": ">=12.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/h2ooooooo/dockline.git",
        "directory": "packages/sftp-client"
    },
    "homepage": "https://github.com/h2ooooooo/dockline#readme",
    "bugs": {
        "url": "https://github.com/h2ooooooo/dockline/issues"
    },
    "scripts": {
        "build": "node ../../scripts/build.mjs --package sftp-client",
        "test": "node ../../scripts/test-package.mjs sftp-client",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@dockline/abstract": "^1.0.0",
        "@flystorage/file-storage": "1.2.2",
        "@types/ssh2": "1.15.6",
        "@types/ssh2-sftp-client": "9.0.6",
        "ssh2-sftp-client": "12.1.1"
    }
}
